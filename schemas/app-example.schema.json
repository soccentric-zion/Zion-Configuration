{
  "id": "app:example",
  "title": "Example customer app",
  "groups": [
    {
      "id": "general",
      "title": "General",
      "fields": [
        {
          "id": "site_id",
          "title": "Site ID",
          "field_type": "string",
          "required": true,
          "validation": { "min_len": 1, "max_len": 32, "pattern": "^[A-Za-z0-9_-]+$" },
          "help": "Unique identifier for this installation site."
        },
        {
          "id": "poll_interval_secs",
          "title": "Poll interval (s)",
          "field_type": "int",
          "validation": { "min": 1, "max": 3600 },
          "help": "How often the app polls the upstream server."
        },
        {
          "id": "log_level",
          "title": "Log level",
          "field_type": "enum",
          "options": [
            { "value": "error", "label": "Error" },
            { "value": "warn", "label": "Warning" },
            { "value": "info", "label": "Info" },
            { "value": "debug", "label": "Debug" }
          ]
        },
        {
          "id": "telemetry_enabled",
          "title": "Enable telemetry",
          "field_type": "bool"
        }
      ]
    },
    {
      "id": "upstream",
      "title": "Upstream credentials",
      "fields": [
        {
          "id": "api_token",
          "title": "API token",
          "field_type": "secret",
          "validation": { "min_len": 16, "max_len": 256 },
          "help": "Stored on the device only; never returned in backups."
        }
      ]
    }
  ],
  "validate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "site_id": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9_-]+$" },
      "poll_interval_secs": { "type": "integer", "minimum": 1, "maximum": 3600 },
      "log_level": { "type": "string", "enum": ["error", "warn", "info", "debug"] },
      "telemetry_enabled": { "type": "boolean" },
      "api_token": { "type": "string", "minLength": 16, "maxLength": 256 }
    },
    "required": ["site_id"]
  }
}