[Unit]
# Embedded Linux Device Dashboard.
# Runs the single-process FastAPI/uvicorn app that serves the SPA, REST API and
# WebSockets. Installed by deploy/install.sh.
Description=Embedded Linux Device Dashboard
Documentation=https://example.invalid/device-dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Dedicated unprivileged service account (created by install.sh). The dashboard
# reads hardware/system state; grant only the access your device actually needs
# (see the "Device permissions" table in README.md) rather than running as root.
User=dashboard
Group=dashboard
SupplementaryGroups=gpio i2c spi dialout

WorkingDirectory=/opt/device-dashboard
Environment=DASHBOARD_CONFIG=/etc/device-dashboard/config.yaml
ExecStart=/opt/device-dashboard/.venv/bin/python -m app.main

Restart=on-failure
RestartSec=3
TimeoutStopSec=10

# --- Hardening -------------------------------------------------------------
# Each relaxation below is here because the dashboard genuinely needs it on a
# real device; tighten further if a feature is unused.
NoNewPrivileges=yes
ProtectSystem=strict          # most of the FS is read-only to the service...
ReadWritePaths=/opt/device-dashboard/data  # ...except its own data dir
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# DeviceAllow / supplementary groups above expose GPIO/I2C/SPI. Drop the lines
# you do not use. Reboot/shutdown actions require polkit rules or CAP_SYS_BOOT.

[Install]
WantedBy=multi-user.target
